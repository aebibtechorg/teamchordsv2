---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts } from '../../lib/posts';
import { PUBLIC_SITE_URL, SITE_DESCRIPTION, SITE_NAME } from '../../lib/site';

const posts = await getBlogPosts();
const canonical = new URL('/stories', PUBLIC_SITE_URL).href;
const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Stories | ${SITE_NAME}`,
  url: canonical,
  description: SITE_DESCRIPTION,
};
---

<BaseLayout
  title="Stories | Team Chords"
  description="Launch announcements, product stories, and updates from Team Chords."
  canonical={canonical}
  imageAlt="Team Chords stories hero artwork"
  jsonLd={collectionJsonLd}
>
  <section class="mx-auto max-w-6xl px-4 pb-10 sm:px-6 lg:px-8">
    <div class="rounded-[2rem] bg-primary px-6 py-12 text-white shadow-xl shadow-primary/10 sm:px-8 sm:py-14">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary-foreground/80">Stories</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">Launch stories and product notes</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-primary-foreground/80">Start with the launch announcement, then read the stories behind the product and the workflow problems Team Chords is built to solve.</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {posts.map((post) => (
        <a class="group rounded-2xl border border-border bg-card p-5 shadow-sm shadow-primary/5 transition hover:-translate-y-1 hover:shadow-lg hover:shadow-primary/10" href={`/stories/${post.slug}`}>
          <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">
            <span class="rounded-full bg-background px-3 py-1 text-foreground">{post.featured ? 'Featured' : 'Article'}</span>
            <span>{post.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
          </div>
          <h2 class="mt-4 text-2xl font-semibold tracking-tight text-foreground transition group-hover:text-foreground">{post.title}</h2>
          <p class="mt-3 text-sm leading-7 text-muted-foreground">{post.description}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {post.tags.map((tag) => <span class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-medium text-muted-foreground">{tag}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
