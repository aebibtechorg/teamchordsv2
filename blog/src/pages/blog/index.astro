---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts } from '../../lib/posts';

const posts = await getBlogPosts();
---

<BaseLayout
  title="Blog | Team Chords"
  description="Launch announcements, product stories, and updates from Team Chords."
>
  <section class="page-heading">
    <p class="eyebrow">Blog</p>
    <h1>Launch stories and product notes</h1>
    <p class="lede">
      Start with the launch announcement, then read the stories behind the product and the workflow problems Team Chords is built to solve.
    </p>
  </section>

  <section class="archive-grid">
    {posts.map((post) => (
      <a class="archive-card" href={`/blog/${post.slug}`}>
        <div class="archive-card-top">
          <span class="pill">{post.featured ? 'Featured' : 'Article'}</span>
          <span class="post-meta">{post.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
        </div>
        <h2>{post.title}</h2>
        <p>{post.description}</p>
        <div class="tag-row">
          {post.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </a>
    ))}
  </section>
</BaseLayout>
