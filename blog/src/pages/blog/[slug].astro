---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPostBySlug, renderPostBody } from '../../lib/posts';

export const prerender = false;

const slug = Astro.params.slug;
const post = slug ? await getBlogPostBySlug(slug) : null;

if (!post) {
  throw new Response(null, { status: 404, statusText: 'Not found' });
}

const canonical = new URL(`/blog/${post.slug}`, Astro.site ?? 'https://teamchords-blog.web.app').toString();
const renderedBody = renderPostBody(post.body);
---

<BaseLayout title={`${post.title} | Team Chords`} description={post.description} canonical={canonical}>
  <article class="post-layout">
    <header class="post-header">
      <div class="post-header-meta">
        <span class="pill">{post.featured ? 'Featured launch' : 'Blog post'}</span>
        <p>{post.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })} · {post.author}</p>
      </div>
      <h1>{post.title}</h1>
      <p class="lede">{post.description}</p>
      <div class="tag-row">
        {post.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </header>

    <figure class="hero-art">
      <img src={post.heroImage ?? '/hero-story.svg'} alt="Launch illustration" />
    </figure>

    <div class="post-body" set:html={renderedBody}></div>
  </article>
</BaseLayout>
