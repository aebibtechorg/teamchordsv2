{
  "expo": {
    "name": "Team Chords",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/teamchords-logo.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121E2E",
        "foregroundImage": "./assets/images/teamchords-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/teamchords-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121E2E",
          "image": "./assets/images/teamchords-logo.png",
          "imageWidth": 200
        }
      ],
      "react-native-auth0"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
